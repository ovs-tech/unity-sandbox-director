/* Timeline Ruler UI Toolkit Styles */

/* Root Ruler Container */
.ruler {
    flex-direction: row;
    height: 30px;
    background-color: var(--surface-color-dark);
    border-bottom-width: var(--border-width);
    border-bottom-color: var(--color-border);
    position: relative;
    overflow: visible;
}

/* Individual Time Markers */
.ruler-marker {
    position: absolute;
    height: 100%;
    width: 1px;
    background-color: var(--color-border);
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

/* Major time markers (every 5 seconds) */
.ruler-marker.major {
    background-color: var(--color-text-muted);
    width: 2px;
}

/* Minor time markers (every second) */
.ruler-marker.minor {
    background-color: var(--surface-color-light);
    height: 60%;
    top: 40%;
}

/* Time Labels */
.ruler-label {
    position: absolute;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    -unity-text-align: upper-left;
    padding-left: var(--space-xs);
    padding-top: var(--space-xs);
    background-color: rgba(0, 0, 0, 0);
    white-space: nowrap;
    overflow: hidden;
}

/* Note: Unity USS doesn't support ::before pseudo-element.
   Use background-image directly on .ruler or create a child VisualElement with class "ruler-background" */
.ruler-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/Scripts/MiniTimeline/UI/Textures/ruler-grid.png');
    background-repeat: repeat-x;
    opacity: 0.3;
    pointer-events: none;
}

/* Hover effects for interactivity */
.ruler:hover {
    background-color: var(--surface-color-light);
}

/* Selected state for ruler */
.ruler.selected {
    background-color: rgba(6, 182, 212, 0.2);
    border-bottom-color: var(--color-secondary);
}

/* Current time indicator line */
.ruler-current-time {
    position: absolute;
    width: 2px;
    height: 100%;
    background-color: var(--color-danger);
    left: 0px;
    z-index: 100;
    pointer-events: none;
}

/* Ruler measurement units */
.ruler-unit-seconds .ruler-label {
    color: var(--color-text-muted);
}

.ruler-unit-frames .ruler-label {
    color: var(--color-success);
}

.ruler-unit-samples .ruler-label {
    color: var(--color-primary);
}

/* Zoom level specific styles */
.ruler.zoom-low .ruler-marker.minor {
    display: none;
}

.ruler.zoom-high .ruler-marker {
    width: 1px;
}

.ruler.zoom-high .ruler-marker.major {
    width: 3px;
}

/* Playhead interaction area */
.ruler-playhead-area {
    position: absolute;
    width: 100%;
    height: 100%;
    cursor: text;
}

/* Snap guidelines */
.ruler-snap-guide {
    position: absolute;
    width: 1px;
    height: 100%;
    background-color: var(--color-warning);
    pointer-events: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.ruler-snap-guide.visible {
    opacity: 1;
}