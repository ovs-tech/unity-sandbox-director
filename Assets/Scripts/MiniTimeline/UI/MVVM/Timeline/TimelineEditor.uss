.timeline-editor {
    flex-direction: column;
    width: 800px;
    height: auto;
    max-height: 500px;
}

.controls-container {
    flex-direction: row;
    height: auto;
    background-color: rgba(60, 60, 60, 0.8);
    border-bottom-width: var(--border-width);
    border-bottom-color: var(--color-border);
    padding-left: var(--space-sm);
    padding-right: var(--space-sm);
    align-items: center;
    flex-grow: 1;
    justify-content: space-around;
    min-height: 50px;
}

.control-button {
    height: 30px;
    width: 30px;
}

.control-button-small {
    height: 20px;
    width: 20px;
}

.playback-controls {
    flex-direction: row;
    margin-right: 0;
    justify-content: space-between;
    align-self: center;
    align-content: center;
    align-items: center;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.time-controls {
    flex-direction: column;
    flex-grow: 1;
    align-items: center;
    margin-left: 10px;
    margin-right: 10px;
}

.time-slider {
    flex-grow: 1;
    width: 100%;
    align-content: center;
    align-self: center;
    justify-content: center;
    height: auto;
}

.time-label {
    width: auto;
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.timeline-container {
    flex-grow: 1;
    background-color: var(--surface-color-dark);
    position: relative;
}

#timeline-scroll {
    flex-grow: 1;
}

.ruler-container {
    height: auto;
    margin-left: 200px;
    background-color: var(--surface-color-light);
    border-bottom-width: var(--border-width);
    border-bottom-color: var(--color-border);
    flex-direction: row;
    min-height: 20px;
}

.ruler {
    width: 100%;
    height: 100%;
    flex-direction: row;
    position: relative;
}

.ruler-marker {
    position: absolute;
    height: 100%;
    border-left-width: var(--border-width);
    border-left-color: var(--color-border);
    justify-content: flex-end;
    align-items: flex-start;
}

.ruler-label {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    margin-left: var(--space-xs);
    margin-top: var(--space-xs);
    -unity-font-style: normal;
}

.tracks-container {
    flex-grow: 1;
    background-color: var(--surface-color-dark);
    flex-direction: column;
    min-height: 200px;
}

.timeline-grid {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.1;
}

.grid-line {
    position: absolute;
    background-color: rgb(150, 150, 150);
    width: 1px;
    height: 100%;
}

.selection-rectangle {
    position: absolute;
    border-color: var(--color-secondary);
    border-width: var(--border-width);
    background-color: rgba(6, 182, 212, 0.2);
}

.drag-preview {
    position: absolute;
    opacity: 0.7;
    border-style: dashed;
    border-width: var(--border-width);
    border-color: var(--color-text-muted);
}

.resize-handle {
    position: absolute;
    width: 6px;
    height: 100%;
    background-color: transparent;
    cursor: resize-horizontal;
}

.resize-handle.left {
    left: -3px;
}

.resize-handle.right {
    right: -3px;
}

.resize-handle:hover {
    background-color: rgba(236, 19, 91, 0.3);
}

.status-bar {
    height: auto;
    background-color: var(--surface-color-dark);
    border-top-width: var(--border-width);
    border-top-color: var(--color-border);
    flex-direction: row;
    align-items: stretch;
    padding-left: var(--space-sm);
    padding-right: var(--space-sm);
    flex-grow: 1;
    justify-content: space-between;
    min-height: 30px;
}

.status-text {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    -unity-text-align: middle-left;
}

.zoom-controls {
    flex-direction: row;
    align-items: center;
}

.zoom-slider {
    width: 100px;
    height: 35px;
    margin-left: var(--space-sm);
    margin-right: var(--space-sm);
}

.loading-indicator {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
}

.loading-spinner {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 3px;
    border-color: var(--color-secondary);
    border-top-color: transparent;
}

.error-message {
    background-color: rgba(239, 68, 68, 0.2);
    border-color: var(--color-danger);
    border-width: var(--border-width);
    padding: var(--space-md);
    margin: var(--space-sm);
    border-radius: var(--border-radius-sm);
}

.error-text {
    color: var(--color-danger);
    font-size: var(--font-size-sm);
}

.success-message {
    background-color: rgba(34, 197, 94, 0.2);
    border-color: var(--color-success);
    border-width: var(--border-width);
    padding: var(--space-md);
    margin: var(--space-sm);
    border-radius: var(--border-radius-sm);
}

.success-text {
    color: var(--color-success);
    font-size: var(--font-size-sm);
}

.time-container {
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
}
