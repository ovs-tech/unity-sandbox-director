.track {
    flex-direction: row;
    height: auto;
    min-height: 60px;
    width: 100%;
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
    background-color: rgb(45, 45, 45);
    position: relative;
    align-items: stretch;
}

.track:hover {
    background-color: rgb(48, 48, 48);
}

.track.selected {
    background-color: rgb(55, 55, 65);
    border-bottom-color: rgb(100, 150, 255);
    border-bottom-width: 2px;
}

.track.disabled {
    opacity: 0.5;
    background-color: rgb(35, 35, 35);
}

.track-header {
    width: 200px;
    height: auto;
    min-width: 150px;
    max-width: 300px;
    background-color: rgb(50, 50, 50);
    border-right-width: 1px;
    border-right-color: rgb(35, 35, 35);
    flex-direction: column;
    justify-content: flex-start;
    flex-shrink: 0;
    position: relative;
    align-items: stretch;
}

.track-header:hover {
    background-color: rgb(55, 55, 55);
}

.track-controls {
    flex-direction: row;
    min-height: 20px;
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 0;
    margin-top: 3px;
    margin-bottom: 3px;
}

.track-enabled-toggle {
    width: 20px;
    height: 20px;
    margin-right: 4px;
}

.track-enabled-toggle .unity-toggle__checkmark {
    border-radius: 2px;
    border-width: 1px;
}

.track-button {
    width: 10px;
    height: 10px;
    margin-left: 2px;
    margin-right: 2px;
}

.track-info {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: flex-start;
}

.track-title {
    color: rgb(220, 220, 220);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
    flex-shrink: 0;
    display: block;
    width: 100%;
}

.track-bind-key {
    color: rgb(150, 150, 150);
    font-size: 8px;
    -unity-text-align: middle-left;
    margin-bottom: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
    flex-shrink: 0;
    display: block;
    width: 100%;
}

.track-type {
    color: rgb(120, 120, 120);
    font-size: 8px;
    -unity-text-align: middle-left;
    text-transform: uppercase;
    flex-shrink: 0;
    display: block;
    width: 100%;
}

.track-subinfo {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.track-subinfo .track-bind-key {
    width: auto;
    flex: 1 1 auto;
    margin-bottom: 0;
}

.track-subinfo .track-type {
    width: auto;
    flex: 0 0 auto;
    margin-left: 8px;
}

.track-menu {
    min-height: 20px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 0;
    flex-shrink: 0;
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 5;
}

.track-content {
    flex-grow: 1;
    position: relative;
    background-color: rgb(42, 42, 42);
    overflow: hidden;
}

.track-content:hover {
    background-color: rgb(45, 45, 45);
}

.track-timeline {
    width: 100%;
    height: auto;
    position: relative;
}

.track-lanes {
    width: 100%;
    height: auto;
    flex-direction: column;
}

.track-lane {
    flex-grow: 1;
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 100, 100, 0.1);
    min-height: 40px;
}

.track-lane.last-lane {
    border-bottom-width: 0;
}

.track-resize-handle {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 4px;
    background-color: transparent;
    cursor: resize-vertical;
}

.track-resize-handle:hover {
    background-color: rgba(100, 150, 255, 0.3);
}

.track.muted {
    opacity: 0.6;
}

.track.muted .track-content {
    background-color: rgb(35, 35, 35);
}

.track.solo .track-content {
    box-shadow: inset 0 0 0 2px rgb(160, 160, 80);
}

.track.recording {
    box-shadow: inset 0 0 0 2px rgb(255, 100, 100);
}

.track.recording .track-header {
    background-color: rgb(80, 40, 40);
}

.track.drag-over {
    background-color: rgba(100, 150, 255, 0.2);
    border-color: rgb(100, 150, 255);
}

.track.drag-target {
    box-shadow: inset 0 0 0 2px rgba(100, 150, 255, 0.8);
}

.track:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px rgb(100, 150, 255);
}

.track.multi-selected {
    background-color: rgba(100, 150, 255, 0.1);
    border-left-width: 3px;
    border-left-color: rgb(100, 150, 255);
}

.track.compact {
    height: 40px;
}

.track.compact .track-header {
    width: 120px;
}

.track.compact .track-title {
    font-size: 11px;
}

.track.compact .track-bind-key,
.track.compact .track-type {
    display: none;
}

.track.compact .track-controls {
    height: 16px;
}

.track.compact .track-button {
    width: 16px;
    height: 14px;
    font-size: 9px;
}

.track.expanded {
    height: 120px;
}

.track.expanded .track-lanes {
    opacity: 1;
}

.track.expanded .track-lane {
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 100, 100, 0.2);
}
