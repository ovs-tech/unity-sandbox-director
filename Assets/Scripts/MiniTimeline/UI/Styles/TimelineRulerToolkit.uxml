<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/MiniTimeline/UI/Styles/TimelineRulerToolkit.uss" />
    <ui:VisualElement name="timeline-ruler" class="ruler">
        <!-- Current time indicator -->
        <ui:VisualElement name="ruler-current-time" class="ruler-current-time" style="left: 0;" />
        
        <!-- Snap guide (initially hidden) -->
        <ui:VisualElement name="ruler-snap-guide" class="ruler-snap-guide" />
        
        <!-- Playhead interaction area -->
        <ui:VisualElement name="ruler-playhead-area" class="ruler-playhead-area" />
        
        <!-- Ruler markers will be dynamically generated by TimelineRulerToolkit.cs -->
        <!-- Template structure for reference:
        <ui:VisualElement class="ruler-marker major">
            <ui:Label text="0.0s" class="ruler-label" />
        </ui:VisualElement>
        <ui:VisualElement class="ruler-marker minor" />
        -->
    </ui:VisualElement>
</ui:UXML>