.clip {
    position: absolute;
    width: 100%;
    height: 100%;
    min-width: 20px;
    min-height: 40px;
    background-color: rgba(80, 120, 160, 0.7);
    border-color: rgb(60, 100, 140);
    border-width: 1px;
    border-radius: 4px;
    overflow: hidden;
    flex-direction: column;
    max-height: 40px;
}

.clip:hover {
    background-color: rgb(90, 130, 170);
    border-color: rgb(70, 110, 150);
}

.clip.selected {
    background-color: rgb(100, 140, 180);
    border-color: rgb(120, 160, 200);
    border-width: 2px;
}

.clip.multi-selected {
    border-color: rgb(255, 200, 100);
}

.clip.disabled {
    opacity: 0.5;
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
}

.clip-header {
    height: 18px;
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    background-color: rgba(0, 0, 0, 0.1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
    margin-right: 10px;
    margin-left: 10px;
}

.clip-icon {
    width: 14px;
    height: 14px;
    justify-content: center;
    align-items: center;
    margin-right: 3px;
}

.clip-type-icon {
    font-size: 10px;
    color: white;
    -unity-text-align: middle-center;
}

.clip-title {
    flex-grow: 1;
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 2px;
}

.clip-status {
    flex-direction: row;
    height: 14px;
    align-items: center;
}

.clip-status-icon {
    width: 10px;
    height: 10px;
    margin-left: 1px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.2);
    display: none;
}

.clip-status-icon.active {
    display: flex;
}

.clip-lock-icon.active {
    background-color: rgb(255, 200, 100);
}

.clip-mute-icon.active {
    background-color: rgb(255, 100, 100);
}

.clip-content {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    margin-right: 10px;
    margin-left: 10px;
}

.clip-preview {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.05);
    overflow: hidden;
}

.clip-markers {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.clip-marker {
    position: absolute;
    width: 2px;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.3);
}

.clip-start-marker {
    left: 0;
}

.clip-end-marker {
    right: 0;
}

.clip-info {
    position: absolute;
    bottom: 2px;
    left: 4px;
    right: 4px;
    height: 16px;
    justify-content: space-between;
    flex-direction: row;
    align-items: center;
}

.clip-duration {
    color: rgba(255, 255, 255, 0.8);
    font-size: 9px;
    -unity-text-align: middle-left;
}

.clip-details {
    color: rgba(255, 255, 255, 0.6);
    font-size: 8px;
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60px;
}

.clip-resize-handles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin-top: 0;
}

.clip-resize-handle {
    position: absolute;
    top: 0;
    width: 10px;
    height: 100%;
    min-width: 10px;
    min-height: 20px;
    background-color: rgba(255, 200, 100, 0.9);
}

.clip-resize-left {
    left: 0;
}

.clip-resize-right {
    right: 0;
}

.clip-resize-handle:hover {
    background-color: rgba(255, 150, 50, 0.9);
}

.clip.selected .clip-resize-handle {
    background-color: rgba(255, 200, 100, 0.8);
}

.clip.selected .clip-resize-handle:hover {
    background-color: rgb(255, 220, 100);
}

.clip-selection-border {
    position: absolute;
    width: 100%;
    height: 100%;
    border-width: 0;
    border-color: transparent;
    border-radius: 4px;
}

.clip.selected .clip-selection-border {
    border-width: 2px;
    border-color: rgb(120, 160, 200);
}

.clip.anim {
    background-color: rgb(80, 160, 80);
    border-color: rgb(60, 140, 60);
}

.clip.anim:hover {
    background-color: rgb(90, 170, 90);
    border-color: rgb(70, 150, 70);
}

.clip.anim.selected {
    background-color: rgb(100, 180, 100);
    border-color: rgb(120, 200, 120);
}

.clip.anim .clip-type-icon {
}

.clip.audio {
    background-color: rgb(160, 80, 80);
    border-color: rgb(140, 60, 60);
}

.clip.audio:hover {
    background-color: rgb(170, 90, 90);
    border-color: rgb(150, 70, 70);
}

.clip.audio.selected {
    background-color: rgb(180, 100, 100);
    border-color: rgb(200, 120, 120);
}

.clip.audio .clip-type-icon {
}

.clip.camera {
    background-color: rgb(160, 160, 80);
    border-color: rgb(140, 140, 60);
}

.clip.camera:hover {
    background-color: rgb(170, 170, 90);
    border-color: rgb(150, 150, 70);
}

.clip.camera.selected {
    background-color: rgb(180, 180, 100);
    border-color: rgb(200, 200, 120);
}

.clip.camera .clip-type-icon {
}

.clip.custom {
    background-color: rgb(160, 80, 160);
    border-color: rgb(140, 60, 140);
}

.clip.custom:hover {
    background-color: rgb(170, 90, 170);
    border-color: rgb(150, 70, 150);
}

.clip.custom.selected {
    background-color: rgb(180, 100, 180);
    border-color: rgb(200, 120, 200);
}

.clip.custom .clip-type-icon {
}

.clip.locked {
    opacity: 0.8;
}

.clip.locked .clip-resize-handle {
    pointer-events: none;
}

.clip.muted {
    opacity: 0.6;
}

.clip.solo {
    border-width: 2px;
    border-color: rgb(255, 255, 100);
}

.clip.playing {
    border-width: 2px;
    border-color: rgba(100, 255, 100, 0.8);
}

.clip.error {
    background-color: rgb(160, 40, 40);
    border-color: rgb(180, 60, 60);
}

.clip.error .clip-title {
    color: rgb(255, 200, 200);
}

.clip.dragging {
    opacity: 0.8;
}

.clip.drag-target {
    background-color: rgba(100, 150, 255, 0.3);
    border-color: rgb(100, 150, 255);
}

.clip.drop-preview {
    opacity: 0.5;
    background-color: rgba(100, 150, 255, 0.2);
}

.clip.small {
    height: 30px;
}

.clip.small .clip-header {
    height: 14px;
}

.clip.small .clip-title {
    font-size: 10px;
}

.clip.small .clip-type-icon {
    font-size: 8px;
}

.clip.large {
    height: 60px;
}

.clip.large .clip-header {
    height: 24px;
}

.clip.large .clip-title {
    font-size: 12px;
}

.clip.large .clip-type-icon {
    font-size: 12px;
}

.clip.audio .clip-preview {
    opacity: 0.3;
}

.clip.anim .clip-preview {
    background-color: rgba(255, 255, 255, 0.02);
}

.clip-keyframe-indicator {
    position: absolute;
    bottom: 1px;
    left: 50%;
    width: 4px;
    height: 4px;
    background-color: rgb(255, 200, 100);
    border-radius: 2px;
}

.clip:focus {
    border-width: 2px;
    border-color: rgba(100, 150, 255, 0.8);
}

.clip {
    transition-property: transform, background-color, border-color, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.clip-header {
    transition-property: background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.clip.blend-add {
}

.clip.blend-multiply {
}

.clip.blend-overlay {
}
