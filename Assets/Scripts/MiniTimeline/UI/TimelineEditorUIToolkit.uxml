<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/MiniTimeline/UI/TimelineEditorUIToolkit.uss?fileID=7433441132597879392&amp;guid=YOUR_USS_GUID&amp;type=3#TimelineEditorUIToolkit" />
    
    <ui:VisualElement name="timeline-editor" class="timeline-editor">
        
        <!-- Controls Container -->
        <ui:VisualElement name="controls-container" class="controls-container">
            
            <!-- Playback Controls -->
            <ui:VisualElement name="playback-controls" class="playback-controls">
                <ui:Button text="Play" name="play-button" class="control-button" />
                <ui:Button text="Pause" name="pause-button" class="control-button" />
                <ui:Button text="Stop" name="stop-button" class="control-button" />
            </ui:VisualElement>
            
            <!-- Time Controls -->
            <ui:VisualElement name="time-controls" class="time-controls">
                <ui:Label text="00:00:00" name="time-label" class="time-label" />
                <ui:Slider picking-mode="Ignore" value="0" high-value="1" name="time-slider" class="time-slider" />
            </ui:VisualElement>
            
            <!-- Edit Controls -->
            <ui:VisualElement name="edit-controls" class="playback-controls">
                <ui:Button text="Undo" name="undo-button" class="control-button" />
                <ui:Button text="Redo" name="redo-button" class="control-button" />
            </ui:VisualElement>
            
            <!-- Track Management Controls -->
            <ui:VisualElement name="track-controls" class="playback-controls">
                <ui:Button text="Add Track" name="add-track-button" class="control-button" />
                <ui:Button text="Bindings" name="binding-manager-button" class="control-button" />
            </ui:VisualElement>
            
            <!-- Project Controls -->
            <ui:VisualElement name="project-controls" class="playback-controls">
                <ui:Button text="Save" name="save-button" class="control-button" />
                <ui:Button text="Load" name="load-button" class="control-button" />
            </ui:VisualElement>
            
        </ui:VisualElement>
        
        <!-- Timeline Scroll View -->
        <ui:ScrollView name="timeline-scroll" class="timeline-scroll" mode="Horizontal">
            
            <!-- Timeline Container -->
            <ui:VisualElement name="timeline-container" class="timeline-container">
                
                <!-- Ruler Container -->
                <ui:VisualElement name="ruler-container" class="ruler-container">
                    <!-- Ruler content will be dynamically generated -->
                </ui:VisualElement>
                
                <!-- Tracks Container -->
                <ui:VisualElement name="tracks-container" class="tracks-container">
                    <!-- Track content will be dynamically generated -->
                </ui:VisualElement>
                
                <!-- Playhead (positioned absolutely) -->
                <ui:VisualElement name="playhead" class="playhead" style="left: 0px;" />
                
            </ui:VisualElement>
            
        </ui:ScrollView>
        
        <!-- Status Bar -->
        <ui:VisualElement name="status-bar" class="status-bar">
            <ui:Label text="Ready" name="status-text" class="status-text" />
            
            <!-- Zoom Controls -->
            <ui:VisualElement name="zoom-controls" class="zoom-controls" style="margin-left: auto;">
                <ui:Label text="Zoom:" class="status-text" />
                <ui:Slider picking-mode="Ignore" value="1" high-value="5" low-value="0.1" name="zoom-slider" class="zoom-slider" />
                <ui:Label text="100%" name="zoom-label" class="status-text" />
            </ui:VisualElement>
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>