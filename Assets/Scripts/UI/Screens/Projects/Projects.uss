.projects-root {
    position: relative;
    flex-grow: 1;
    min-height: 100%;
    background-color: rgb(31, 15, 17);
    display: flex;
    flex-direction: column;
}

.top-appbar {
    height: 56px;
    padding: 8px 12px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255,255,255,0.03);
}

.brand-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(255,79,118);
}

.title {
    font-size: 16px;
    color: rgb(251,219,221);
    -unity-font-style: bold;
}

.search-filters {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.search-row {
    display: flex;
}

.search-field {
    flex-grow: 1;
    height: 36px;
    border-radius: 10px;
    padding-left: 10px;
    background-color: rgba(255,255,255,0.03);
    color: rgb(251,219,221);
}

.chips-row {
    display: flex;
    flex-direction: row;
    gap: 8px;
    overflow: hidden;
}

.chip {
    height: 32px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background-color: rgba(255,255,255,0.03);
    color: rgb(219,189,192);
}

.chip-primary {
    background-color: rgb(255,178,187);
    color: rgb(31,15,17);
}