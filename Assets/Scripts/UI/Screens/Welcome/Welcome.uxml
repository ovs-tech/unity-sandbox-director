<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="Welcome.uss" />
    <ui:VisualElement name="welcome-root" class="welcome-root">
        <ui:VisualElement name="background-image" class="background-image"/>
        <ui:VisualElement name="background-overlay" class="background-overlay"/>
        <ui:VisualElement name="content" class="content">
            <ui:VisualElement name="top-section" class="top-section">
                <ui:VisualElement name="vr-ar-badge" class="vr-ar-badge">
                    <ui:Label name="vr-ar-badge-icon" text="AR" class="vr-ar-badge-icon"/>
                    <ui:Label name="vr-ar-badge-text" text="VR/AR Ready" class="vr-ar-badge-text"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="middle-section" class="middle-section">
                <ui:VisualElement name="logo-icon-wrap" class="logo-icon-wrap">
                    <ui:Label name="logo-icon" text="FILM" class="logo-icon"/>
                </ui:VisualElement>
                <ui:Label name="title-main" text="Ero Director" class="title-main"/>
                <ui:Label name="tagline" text="Your Vision. Your Scene. Your Rules." class="tagline"/>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-section" class="bottom-section">
                <appui:Toggle name="age-gate-toggle" label="I confirm I am over 18 years of age." value="false" class="age-gate-toggle" scale="medium"/>
                <appui:Button name="start-directing-button" title="Start Directing" class="start-directing-button" scale="large"/>
                <ui:VisualElement name="secondary-actions" class="secondary-actions">
                    <appui:Button name="login-link-button" title="Already a Director? Login" class="login-link-button" scale="medium"/>
                    <ui:VisualElement name="privacy-row" class="privacy-row">
                        <appui:Icon name="privacy-lock" text="LOCK" icon-name="lock-icon" class="privacy-lock" scale="medium"/>
                        <ui:Label name="privacy-text" text="Secure &amp; Private" class="privacy-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
