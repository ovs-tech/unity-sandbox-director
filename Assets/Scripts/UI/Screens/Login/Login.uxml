<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement
        name="login-root"
        style="position: relative; flex-grow: 1; min-height: 100%; background-color: rgb(31, 15, 17); overflow: hidden;"
    >
        <ui:VisualElement
            name="background-base"
            style="position: absolute; left: -120px; top: -96px; width: 360px; height: 360px; border-top-left-radius: 180px; border-top-right-radius: 180px; border-bottom-left-radius: 180px; border-bottom-right-radius: 180px; background-color: rgba(189, 0, 69, 0.28);"
        />

        <ui:VisualElement
            name="background-accent"
            style="position: absolute; right: -100px; top: 140px; width: 280px; height: 280px; border-top-left-radius: 140px; border-top-right-radius: 140px; border-bottom-left-radius: 140px; border-bottom-right-radius: 140px; background-color: rgba(239, 103, 31, 0.18);"
        />

        <ui:VisualElement
            name="background-shadow"
            style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(24, 10, 14, 0.62);"
        />

        <ui:VisualElement
            name="content"
            style="position: relative; flex-grow: 1; justify-content: space-between; padding-left: 24px; padding-right: 24px; padding-top: 32px; padding-bottom: 36px;"
        >
            <ui:VisualElement
                name="brand-section"
                style="align-items: center; padding-top: 28px;"
            >
                <ui:VisualElement
                    name="brand-icon-wrap"
                    style="width: 48px; height: 48px; align-items: center; justify-content: center; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; background-color: rgb(255, 79, 118);"
                >
                    <ui:Label
                        name="brand-icon"
                        text="FILM"
                        style="font-size: 11px; color: rgb(255, 255, 255); -unity-font-style: bold; unity-text-align: middle-center;"
                    />
                </ui:VisualElement>

                <ui:Label
                    name="brand-title"
                    text="Ero Director"
                    style="margin-top: 12px; font-size: 28px; color: rgb(255, 255, 255); -unity-font-style: bold; unity-text-align: middle-center;"
                />
            </ui:VisualElement>

            <ui:VisualElement
                name="form-stack"
                style="gap: 24px;"
            >
                <ui:VisualElement
                    name="welcome-copy"
                    style="align-items: center; gap: 6px;"
                >
                    <ui:Label
                        name="welcome-title"
                        text="Welcome Back"
                        style="font-size: 24px; color: rgb(255, 255, 255); -unity-font-style: bold; unity-text-align: middle-center;"
                    />

                    <ui:Label
                        name="welcome-subtitle"
                        text="Log in to continue your production."
                        style="font-size: 13px; color: rgba(255, 255, 255, 0.58); unity-text-align: middle-center;"
                    />
                </ui:VisualElement>

                <ui:VisualElement
                    name="login-form"
                    style="gap: 18px;"
                >
                    <ui:VisualElement
                        name="username-group"
                        style="gap: 6px;"
                    >
                        <ui:Label
                            name="username-label"
                            text="USERNAME OR EMAIL"
                            style="margin-left: 2px; font-size: 11px; color: rgb(172, 136, 139); -unity-font-style: bold; letter-spacing: 1.2px;"
                        />

                        <ui:VisualElement
                            name="username-shell"
                            style="flex-direction: row; align-items: center; min-height: 58px; padding-left: 14px; padding-right: 14px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-color: rgba(255, 255, 255, 0.10); background-color: rgba(255, 255, 255, 0.03);"
                        >
                            <ui:Label
                                name="username-icon"
                                text="@"
                                style="width: 22px; margin-right: 12px; font-size: 16px; color: rgb(172, 136, 139); unity-text-align: middle-center;"
                            />

                            <ui:TextField
                                name="username-field"
                                style="flex-grow: 1; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"
                            />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement
                        name="password-group"
                        style="gap: 6px;"
                    >
                        <ui:Label
                            name="password-label"
                            text="PASSWORD"
                            style="margin-left: 2px; font-size: 11px; color: rgb(172, 136, 139); -unity-font-style: bold; letter-spacing: 1.2px;"
                        />

                        <ui:VisualElement
                            name="password-shell"
                            style="flex-direction: row; align-items: center; min-height: 58px; padding-left: 14px; padding-right: 10px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-color: rgba(255, 255, 255, 0.10); background-color: rgba(255, 255, 255, 0.03);"
                        >
                            <ui:Label
                                name="password-icon"
                                text="*"
                                style="width: 22px; margin-right: 12px; font-size: 18px; color: rgb(172, 136, 139); unity-text-align: middle-center;"
                            />

                            <ui:TextField
                                name="password-field"
                                is-password-field="true"
                                style="flex-grow: 1; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"
                            />

                            <ui:Button
                                name="password-visibility-button"
                                text="SHOW"
                                style="min-width: 58px; height: 30px; margin-left: 8px; color: rgba(255, 255, 255, 0.72); background-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 10px; -unity-font-style: bold;"
                            />
                        </ui:VisualElement>

                        <ui:VisualElement
                            name="forgot-row"
                            style="flex-direction: row; justify-content: flex-end; padding-top: 4px;"
                        >
                            <ui:Button
                                name="forgot-password-button"
                                text="Forgot Password?"
                                style="height: 24px; padding-left: 0; padding-right: 0; color: rgb(172, 136, 139); background-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 11px;"
                            />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button
                        name="login-button"
                        text="LOGIN"
                        style="height: 58px; margin-top: 8px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; background-color: rgb(255, 79, 118); color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 18px;"
                    />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement
                name="bottom-section"
                style="align-items: center; gap: 18px; padding-top: 20px;"
            >
                <ui:VisualElement
                    name="signup-row"
                    style="flex-direction: row; align-items: center; gap: 6px;"
                >
                    <ui:Label
                        name="signup-prefix"
                        text="New Director?"
                        style="font-size: 12px; color: rgba(255, 255, 255, 0.72);"
                    />

                    <ui:Button
                        name="create-account-button"
                        text="Create Account"
                        style="height: 24px; padding-left: 0; padding-right: 0; color: rgb(255, 178, 187); background-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-style: bold; font-size: 12px;"
                    />
                </ui:VisualElement>

                <ui:VisualElement
                    name="security-row"
                    style="flex-direction: row; align-items: center; gap: 6px; opacity: 0.38;"
                >
                    <ui:Label
                        name="security-icon"
                        text="LOCK"
                        style="font-size: 9px; color: rgb(255, 255, 255); -unity-font-style: bold;"
                    />

                    <ui:Label
                        name="security-text"
                        text="Secure Connection"
                        style="font-size: 10px; color: rgb(255, 255, 255); -unity-font-style: bold;"
                    />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>