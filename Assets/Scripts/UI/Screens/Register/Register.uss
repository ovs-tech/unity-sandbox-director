.register-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(34, 16, 22);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.background-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(46, 24, 34);
}

.background-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(24, 10, 14, 0.58);
}

.content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 32px 24px;
}

.header {
    align-items: center;
    margin-bottom: 18px;
}

.logo-icon-wrap {
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: rgb(236, 19, 91);
}

.logo-icon {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.title-main {
    margin-top: 12px;
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    unity-text-align: middle-center;
}

.subtitle {
    margin-top: 6px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    unity-text-align: middle-center;
}

.form-container {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border-radius: 12px;
    background-color: rgba(0,0,0,0.22);
    border: 1px solid rgba(255,255,255,0.04);
}

.input {
    height: 44px;
    border-radius: 10px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(255,255,255,0.03);
    color: rgb(255,255,255);
    -unity-font-style: normal;
}

.checks {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
}

.register-button {
    margin-top: 8px;
    height: 48px;
    border-radius: 12px;
    background-color: rgb(236, 19, 91);
    color: rgb(255,255,255);
    -unity-font-style: bold;
    font-size: 16px;
    border-width: 0;
}

.secondary-row {
    margin-top: 10px;
    align-items: center;
    justify-content: space-between;
    display: flex;
}

.login-link-button {
    background-color: rgba(255,255,255,0);
    color: rgba(255,255,255,0.75);
    border-width: 0;
    font-size: 13px;
}

.privacy-row {
    flex-direction: row;
    align-items: center;
    opacity: 0.7;
}

.privacy-lock {
    font-size: 12px;
    color: rgb(255,255,255);
    margin-right: 6px;
}

.privacy-text {
    font-size: 12px;
    color: rgb(255,255,255);
}
