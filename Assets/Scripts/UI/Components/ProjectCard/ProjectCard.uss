.ProjectCard {
  width: 100%;
  padding: 8px;
  border-radius: 12px;
  background-color: rgb(54, 30, 37);
  flex-direction: column;
  gap: 8px;
}

.card-media {
  width: 100%;
  height: 275px;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  background-color: rgba(0, 0, 0, 0.25);
}

.card-image {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: #2b2b2b;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}

.card-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34%;
  background-color: rgba(0, 0, 0, 0.58);
  background-image: linear-gradient(to top, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0));
}

.card-badge {
  position: absolute;
  left: 8px;
  top: 8px;
  display: none;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-radius: 6px;
  font-size: 10px;
  unity-font-style: Bold;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.62);
}

.card-menu-button {
  position: absolute;
  right: 8px;
  top: 8px;
  width: 26px;
  height: 26px;
  padding: 0;
  border-radius: 13px;
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
  background-color: rgba(0, 0, 0, 0.42);
  color: #ffffff;
  unity-text-align: middle-center;
}

.card-content {
  width: 100%;
  flex-direction: column;
  gap: 2px;
}

.project-name {
  font-size: 14px;
  unity-font-style: Bold;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  -unity-text-overflow-position: end;
}

.project-meta {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.72);
  white-space: nowrap;
  overflow: hidden;
  -unity-text-overflow-position: end;
}
