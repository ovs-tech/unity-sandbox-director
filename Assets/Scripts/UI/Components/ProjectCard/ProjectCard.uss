.ProjectCard {
.ProjectCard {
  padding: 8px;
  border-bottom: 1px solid #e0e0e0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.card-image {
  width: 56px;
  height: 56px;
  margin-right: 12px;
  background-color: #ddd;
  border-radius: 4px;
}

.card-body {
  display: flex;
  flex-direction: column;
}

.ProjectCard > .card-body > Label#project-name {
  font-size: 14px;
  unity-font-style: Bold;
}

.ProjectCard > .card-body > Label#project-meta {
  font-size: 12px;
  color: #666;
}
