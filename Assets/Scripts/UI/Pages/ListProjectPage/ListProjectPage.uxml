<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd">
    <Style src="project://database/Assets/Scripts/UI/Pages/ListProjectPage/ListProjectPage.uss?fileID=0&amp;guid=00000000000000000000000000000000&amp;type=3#ListProjectPage"/>

    <ui:VisualElement name="list-project-root" class="search-filters">
        <ui:VisualElement class="search-row">
            <appui:TextField name="search-field" class="search-field"/>
        </ui:VisualElement>

        <ui:VisualElement class="chips-row">
            <appui:Button title="All" class="chip chip-primary"/>
            <appui:Button title="VR Mode" class="chip"/>
            <appui:Button title="AR Mode" class="chip"/>
            <appui:Button title="Standard" class="chip"/>
            <appui:Button title="Drafts" class="chip"/>
        </ui:VisualElement>

        <!-- Projects grid moved here -->
        <ui:ScrollView name="projects-scroll" class="projects-scroll">
            <ui:VisualElement class="projects-grid">
                    <!-- Example project card (repeat/populate from code) -->
                    <ProjectCard project-name="Late Night Scene 01" project-meta="2h ago · 3 Actors" />
                </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
