/* Object Palette UI Toolkit Styles */

/* Main Palette Container */
.palette-panel {
    background-color: rgba(30, 30, 30, 0.95);
    border-width: 1px;
    border-color: rgba(60, 60, 60, 1);
    border-radius: 4px;
    padding: 8px;
    min-width: 250px;
    max-width: 400px;
}

/* Palette Header */
.palette-panel .panel__header {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 80, 1);
}

/* Filters Container */
.filters-container {
    background-color: rgba(40, 40, 40, 1);
    padding: 8px;
    border-radius: 4px;
    margin-bottom: 8px;
}

.filters-container .unity-dropdown-field,
.filters-container .unity-text-field {
    margin-top: 4px;
    margin-bottom: 4px;
}

.filters-container .unity-dropdown-field__label,
.filters-container .unity-text-field__label {
    min-width: 60px;
    color: rgb(200, 200, 200);
    font-size: 12px;
}

.filters-container .unity-dropdown-field__input,
.filters-container .unity-text-field__input {
    background-color: rgba(50, 50, 50, 1);
    border-width: 1px;
    border-color: rgba(70, 70, 70, 1);
    border-radius: 3px;
    color: rgb(255, 255, 255);
    padding: 4px;
}

.filters-container .unity-dropdown-field__input:hover,
.filters-container .unity-text-field__input:hover {
    border-color: rgba(100, 100, 100, 1);
}

.filters-container .unity-dropdown-field__input:focus,
.filters-container .unity-text-field__input:focus {
    border-color: rgb(77, 150, 255);
    border-width: 2px;
}

/* Refresh Button */
.button {
    background-color: rgba(70, 70, 70, 1);
    border-width: 1px;
    border-color: rgba(90, 90, 90, 1);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    padding: 6px 12px;
    margin: 2px;
    cursor: link;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.button:hover {
    background-color: rgba(90, 90, 90, 1);
    border-color: rgba(110, 110, 110, 1);
}

.button:active {
    background-color: rgba(60, 60, 60, 1);
}

.button--primary {
    background-color: rgba(77, 150, 255, 1);
    border-color: rgba(97, 170, 255, 1);
}

.button--primary:hover {
    background-color: rgba(97, 170, 255, 1);
}

.button--primary:active {
    background-color: rgba(57, 130, 235, 1);
}

.button--secondary {
    background-color: rgba(70, 70, 70, 1);
    border-color: rgba(90, 90, 90, 1);
}

.button--secondary:hover {
    background-color: rgba(90, 90, 90, 1);
}

.button--danger {
    background-color: rgba(220, 53, 69, 1);
    border-color: rgba(200, 35, 51, 1);
}

.button--danger:hover {
    background-color: rgba(200, 35, 51, 1);
}

.button--success {
    background-color: rgba(40, 167, 69, 1);
    border-color: rgba(34, 147, 59, 1);
}

.button--success:hover {
    background-color: rgba(34, 147, 59, 1);
}

.button--warning {
    background-color: rgba(255, 193, 7, 1);
    border-color: rgba(235, 173, 0, 1);
    color: rgb(30, 30, 30);
}

.button--warning:hover {
    background-color: rgba(235, 173, 0, 1);
}

/* Items Scroll View */
.items-scroll-view {
    flex-grow: 1;
    margin-top: 8px;
}

.items-scroll-view .unity-scroll-view__content-viewport {
    background-color: rgba(25, 25, 25, 1);
    border-radius: 4px;
}

.items-scroll-view .unity-scroller {
    width: 12px;
}

.items-scroll-view .unity-scroller__slider {
    background-color: rgba(50, 50, 50, 1);
}

.items-scroll-view .unity-scroller__low-button,
.items-scroll-view .unity-scroller__high-button {
    display: none;
}

/* Items Container */
.items-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
    justify-content: flex-start;
    align-content: flex-start;
}

/* Empty State */
.palette-empty-state {
    color: rgb(150, 150, 150);
    font-size: 14px;
    -unity-text-align: middle-center;
    padding: 40px 20px;
}

/* Loading State */
.palette-loading {
    color: rgb(77, 150, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    padding: 40px 20px;
}
