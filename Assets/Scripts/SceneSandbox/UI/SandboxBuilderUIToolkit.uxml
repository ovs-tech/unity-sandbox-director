<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/SceneSandbox/UI/SandboxBuilderUIToolkit.uss?fileID=7433441132597879392&amp;guid=4b37fe75aecc622458cd37a2fbb1c7a1&amp;type=3#SandboxBuilderUIToolkit" />
    <ui:VisualElement name="main-container" class="main-container" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="left-panel" class="panel left-panel">
            <ui:Label text="Object Palette" name="palette-title" class="panel__header">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.palette.title" />
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="palette-container" style="flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="center-panel" class="center-panel" style="flex-grow: 1;">
            <ui:VisualElement name="scene-controls-panel" class="panel controls-panel">
                <ui:Label text="Scene Builder" class="panel__header">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.sceneBuilder.title" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement name="project-controls-row" class="project-controls-row">
                    <ui:TextField name="project-name-input" class="project-name-input" label="Project Name">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.projectName.label" />
                        </Bindings>
                    </ui:TextField>
                    <ui:VisualElement name="project-buttons-group" style="flex-direction: row;">
                        <ui:Button text="\u002b" name="new-project-button" parse-escape-sequences="true" class="button button--secondary fa-solid" />
                        <ui:Button text="\uf019" name="save-project-button" parse-escape-sequences="true" class="button button--primary fa-solid" />
                        <ui:Button text="\uf093" name="load-project-button" parse-escape-sequences="true" class="button button--secondary fa-solid" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="scene-controls-row" class="scene-controls-row" style="flex-direction: row; margin-top: 8px;">
                    <ui:Button text="New Scene" name="new-scene-button" class="button button--secondary">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.newScene.button" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="Save Scene" name="save-scene-button" class="button button--primary">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.saveScene.button" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="Load Scene" name="load-scene-button" class="button button--secondary">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.loadScene.button" />
                        </Bindings>
                    </ui:Button>
                    <ui:Button text="\uf12d" name="clear-scene-button" parse-escape-sequences="true" class="button button--danger fa-solid" />
                </ui:VisualElement>
                <ui:VisualElement name="preview-controls-row" class="preview-controls-row" style="flex-direction: row; margin-top: 8px;">
                    <ui:Button text="\uf04b" name="preview-button" parse-escape-sequences="true" class="button button--success fa-solid" />
                    <ui:Button text="\uf04d" name="stop-preview-button" parse-escape-sequences="true" class="button button--warning fa-solid" />
                </ui:VisualElement>
                <ui:Label text="No project loaded" name="current-project-text" style="margin-top: 8px; font-size: 12px;" />
            </ui:VisualElement>
            <ui:VisualElement name="scene-info-panel" class="panel scene-info-panel" style="margin-top: 8px;">
                <ui:VisualElement name="scene-info-row" class="scene-info-row" style="flex-direction: row; justify-content: space-between;">
                    <ui:Label text="Scene: None" name="scene-name-text" style="font-size: 12px;" />
                    <ui:Label text="Objects: 0" name="object-count-text" style="font-size: 12px;" />
                    <ui:Label text="Edit Mode" name="preview-status-text" style="font-size: 12px; color: rgb(34, 197, 94);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="viewport-area" picking-mode="Ignore" class="viewport-area" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
        </ui:VisualElement>
        <ui:VisualElement name="right-panel" class="panel right-panel">
            <ui:VisualElement name="object-controls-panel" class="object-controls-panel">
                <ui:Label text="Object Controls" class="panel__header">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.objectControls.title" />
                    </Bindings>
                </ui:Label>
                <ui:Button text="\uf1f8" name="delete-object-button" parse-escape-sequences="true" class="button button--danger fa-solid" style="margin-top: 8px;" />
                <ui:Label text="Grid Settings" style="margin-top: 16px; font-size: 14px; -unity-font-style: bold;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.gridSettings.title" />
                    </Bindings>
                </ui:Label>
                <ui:Toggle label="Snap to Grid" name="snap-to-grid-toggle" style="margin-top: 8px;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.snapToGrid.toggle" />
                    </Bindings>
                </ui:Toggle>
                <ui:VisualElement style="margin-top: 8px;">
                    <ui:Label text="Grid Size: 1.0" name="grid-size-text" style="font-size: 12px; margin-bottom: 4px;" />
                    <ui:Slider label="Grid Size" name="grid-size-slider" low-value="0.1" high-value="5" value="1" show-input-field="false">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.gridSize.slider" />
                        </Bindings>
                    </ui:Slider>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="mobile-controls-panel" class="mobile-controls" style="position: absolute; bottom: 0; left: 0; right: 0; height: 60px; display: none;">
        <ui:VisualElement name="mobile-button-row" style="flex-direction: row; justify-content: space-around; align-items: center; flex-grow: 1;">
            <ui:Button text="Palette" name="mobile-palette-toggle" class="button button--secondary">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.palette.button" />
                </Bindings>
            </ui:Button>
            <ui:Button text="Properties" name="mobile-properties-toggle" class="button button--secondary">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:224f44bb68ac0fc409cf2bd015746ae1" entry="sandbox.properties.button" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
