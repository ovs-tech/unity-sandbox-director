Switch {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
}

Switch Label {
    flex: 0 0 auto;
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-font-style: normal;
}

Switch Label.switch__label--hidden {
    display: none;
}

.switch__border {
    width: 48px;
    height: 24px;
    background-color: rgb(60, 60, 60);
    border-radius: 12px;
    padding: 2px;
    transition: background-color 0.3s ease;
    display: flex;
    align-items: center;
}

.switch__border:hover {
    background-color: rgb(80, 80, 80);
}

.switch__border--on {
    background-color: rgb(76, 175, 80);
    border-color: rgb(102, 187, 106);
}

.switch__border--on:hover {
    background-color: rgb(102, 187, 106);
}

.switch__control {
    width: 20px;
    height: 20px;
    background-color: rgb(200, 200, 200);
    border-radius: 50%;
    transition: margin-left 0.3s ease;
    margin-left: 0;
}

.switch__control--on {
    margin-left: auto;
}