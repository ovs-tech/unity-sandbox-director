.panel {
    position: absolute;
    flex-direction: column;
    background-color: rgb(45, 45, 45);
    border-width: 1px;
    border-color: rgb(30, 30, 30);
    border-radius: 4px;
    min-width: 200px;
    min-height: 150px;
    width: 400px;
    height: 300px;
}

.panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(60, 60, 60);
    padding: 8px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 30, 30);
    min-height: 32px;
}

.panel__title {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(220, 220, 220);
    flex-grow: 1;
}

.panel__close-button {
    width: 24px;
    height: 24px;
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    font-size: 20px;
    color: rgb(180, 180, 180);
    -unity-text-align: middle-center;
}

.panel__close-button:hover {
    background-color: rgb(200, 50, 50);
    color: rgb(255, 255, 255);
    border-radius: 2px;
}

.panel__close-button:active {
    background-color: rgb(170, 40, 40);
}

.panel__body {
    flex-grow: 1;
    padding: 12px;
    background-color: rgb(50, 50, 50);
    overflow: hidden;
}

.panel__footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    background-color: rgb(55, 55, 55);
    padding: 8px 12px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top-width: 1px;
    border-top-color: rgb(30, 30, 30);
    min-height: 32px;
}

.panel__resize-corner {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 16px;
    height: 16px;
    cursor: resize-up-left;
    background-color: transparent;
}

.panel__resize-corner:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

/* Add a visual indicator for the resize corner */
.panel__resize-corner::after {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(120, 120, 120);
}
