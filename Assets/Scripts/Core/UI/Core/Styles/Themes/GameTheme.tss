@import url("unity-theme://default");

:root {
    /* Main Theme Colors */
    --color-primary: #ec135b;
    --color-primary-hover: #d41152;
    --color-primary-active: #b80f49;
    --color-primary-contrast: #ffffff;
    --color-primary-transparent: rgba(236, 19, 91, 0.1);

    /* Text Colors */
    --color-text-primary: #ffffff;
    --color-text-secondary: #b99da6;
    --color-text-muted: #9ca3af;
    --color-text-disabled: #6b7280;

    /* Background & Surface Colors (Dark Theme) */
    --color-background: #221016;
    --color-surface-1: #2d1a1f;
    --color-surface-2: #3d242a;
    --color-surface-3: #181113;
    --color-surface-border: rgba(255, 255, 255, 0.1);

    /* Status Colors */
    --color-success: #22c55e;
    --color-warning: #facc15;
    --color-danger: #ef4444;
    --color-info: #3b82f6;

    /* DLC Store Theme Colors (as secondary palette) */
    --color-secondary-theme-primary: #7f13ec;
    --color-secondary-theme-primary-dark: #5e0eb0;
    --color-secondary-theme-background: #191022;
    --color-secondary-theme-surface: #2a1f36;

    /* Fonts (will need to be linked in Unity) */
    --font-family-display: 'Plus Jakarta Sans';
    --font-family-body: 'Noto Sans';
    --font-family-special: 'Space Grotesk';

    /* Sizes and Radii from design */
    --font-size-xs: 10px;
    --font-size-sm: 12px;
    --font-size-base: 14px;
    --font-size-md: 16px;
    --font-size-lg: 18px;
    --font-size-xl: 20px;
    --font-size-2xl: 24px;

    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-bold: 700;

    --border-radius-sm: 4px;
    --border-radius-md: 8px;
    --border-radius-lg: 12px;
    --border-radius-xl: 16px;
    --border-radius-2xl: 24px;
    --border-radius-full: 9999px;

    /* Other tokens */
    --border-width: 1px;
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.15);
    --transition: 0.3s ease;
}

/* Dùng FontAsset (TextCore) — kéo thả trong Inspector */
.fa-solid {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Free-Solid-900 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.fa-regular {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Free-Regular-400 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.fa-brands {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Brands-Regular-400 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* Common Toggle Styles */
.unity-toggle .unity-toggle__checkmark {
    background-color: var(--color-surface-1);
    border-color: var(--color-surface-border);
    border-width: var(--border-width);
}

.unity-toggle--checked .unity-toggle__checkmark {
    background-color: var(--color-primary);
}

/* Common Slider Styles */
.unity-slider .unity-base-slider__tracker {
    height: 4px;
    background-color: var(--color-surface-1);
    border-radius: 2px;
}

.unity-slider .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--color-text-primary);
    border-width: 0;
}

/* Common Scroll View Styles */
.unity-scroll-view {
    flex-grow: 1;
}

.unity-scroll-view .unity-scroller--vertical {
    width: 6px;
}

.unity-scroll-view .unity-scroller--vertical .unity-slider {
    background-color: var(--color-surface-1);
    border-radius: 3px;
}

.unity-scroll-view .unity-scroller--vertical .unity-slider .unity-slider__dragger {
    background-color: var(--color-text-secondary);
    border-radius: 3px;
}

/* Common Dropdown Styles */
.unity-dropdown-field .unity-text-field__input {
    background-color: var(--color-surface-1);
    border-width: var(--border-width);
    border-color: var(--color-surface-border);
    border-radius: var(--border-radius-md);
    color: var(--color-text-primary);
}

/* Button theme */
.unity-button {
    -unity-font-style: bold;
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    background-color: var(--color-surface-1);
    border-color: var(--color-surface-border);
    border-width: var(--border-width);
    border-radius: var(--border-radius-md);
    -unity-text-align: middle-center;
    padding: 8px 16px;
}

.unity-button:hover {
    background-color: var(--color-primary-hover); /* darker on hover */
}

.unity-button:active {
    background-color: var(--color-primary-hover);
}

.unity-button:disabled {
    opacity: 0.5;
    pointer-events: none;
}

.unity-button--secondary {
    background-color: transparent;
    border-width: var(--border-width);
    border-color: var(--color-border); /* light border */
    color: var(--color-primary-light); /* primary text */
}

.unity-button--icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    -unity-content-align: middle-center;
}

/* Button variants */
.unity-button--primary {
    /* explicit primary — same as base but kept for clarity & tokens */
    background-color: var(--color-primary);
    color: var(--color-bg);
}

.unity-button--success {
    background-color: var(--color-success); /* green */
    color: var(--color-bg);
}

.unity-button--danger {
    background-color: var(--color-danger); /* red */
    color: var(--color-bg);
}

.unity-button--warning {
    background-color: var(--color-warning); /* orange */
    color: var(--color-bg);
}

.unity-button--ghost {
    background-color: transparent;
    color: var(--color-primary); /* using primary color for ghost text */
    border-width: 0;
}

.unity-button--circle {
    border-radius: var(--border-radius-full);
}

.unity-button--no-border {
    border-width: 0;
}

/* Hover/active states for variants (uses color darkening) */
.unity-button--success:hover { background-color: var(--color-success);  }
.unity-button--success:active { background-color: var(--color-success);  }

.unity-button--danger:hover { background-color: var(--color-danger);  }
.unity-button--danger:active { background-color: var(--color-danger);  }

.unity-button--warning:hover { background-color: var(--color-warning);  }
.unity-button--warning:active { background-color: var(--color-warning);  }

.unity-button--ghost:hover { background-color: rgba(79,70,229,0.06); }
.unity-button--ghost:active { background-color: rgba(79,70,229,0.12); }


/* Panel - a generic container used across UI for card/panel backgrounds */
.panel {
    background-color: var(--color-bg);
    border-width: var(--border-width);
    border-color: var(--color-border); /* subtle border */
    border-radius: var(--border-radius-md);
    padding: var(--space-md);
    color: var(--color-text); /* default panel text color */
    -unity-transition-property: background-color, opacity;
}

.panel--elevated {
    /* Slightly stronger visual elevation variant */
    border-color: rgba(2,6,23,0.06);
    /* unity-box-shadow is supported in newer Unity versions; if unavailable it will be ignored */
    unity-box-shadow: var(--shadow-lg);
}

.panel__header {
    font-size: var(--font-size-md);
    margin-bottom: var(--space-sm);
    color: var(--color-text);
}
