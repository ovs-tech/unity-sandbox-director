@import url("unity-theme://default");

:root {
    /* Primary Colors */
    --color-primary: #ec135b;
    --color-primary-hover: #ec135b65;
    --color-secondary: #06b6d4;
    --color-primary-light: #f8f6f6;
    --color-primary-dark: #221016;

    --background-color-dark: #f8f6f6;
    --background-color-dark-opacity: #f8f6f60a;
    --background-color-light: #181113;

    --surface-color-dark: #241a1d;
    --surface-color-light: #3a2a30;

    /* Status Colors */
    --color-success: #22c55e;
    --color-warning: #facc15;
    --color-danger: #ef4444;
    --color-info: #3b82f6;

    /* Neutral Colors */
    --color-bg: #ffffff;
    --color-bg-alt: #f9fafb;
    --color-text: #111827;
    --color-text-muted: #6b7280;
    --color-border: #e5e7eb;

    --font-family: 'Inter', sans-serif;

    --font-size-xs: 10px;
    --font-size-sm: 12px;
    --font-size-md: 16px;
    --font-size-lg: 18px;
    --font-size-xl: 24px;

    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-bold: 700;

    --line-height: 1.5;

    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;

    --container-width: 1200px;

    --border-width: 1px;
    --border-radius-sm: 4px;
    --border-radius-md: 8px;
    --border-radius-lg: 12px;
    --border-radius-full: 50%;

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.15);

    --transition: 0.3s ease;
}

/* Dùng FontAsset (TextCore) — kéo thả trong Inspector */
.fa-solid {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Free-Solid-900 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.fa-regular {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Free-Regular-400 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.fa-brands {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Brands-Regular-400 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* Common Toggle Styles */
.unity-toggle .unity-toggle__checkmark {
    background-color: var(--color-primary);
}

.unity-toggle .unity-toggle__input:checked .unity-toggle__checkmark {
    color: var(--color-primary-light);
}

/* Common Slider Styles */
.unity-slider {
    margin-top: 4px;
    margin-bottom: 4px;
}

.unity-slider .unity-base-slider__drag-container {
    border-radius: 0px;
}

.unity-slider .unity-base-slider__tracker {
    background-color: var(--color-primary-dark);
    border-radius: 5px;
}

.unity-slider .unity-base-slider__dragger {
    background-color: var(--color-primary-light);
    width: 5px;
    height: 20px;
    border-radius: 30%;
    border-width: 1px;
    border-color: var(--color-primary-light);
}

/* Common Scroll View Styles */
ScrollView {
    flex-grow: 1;
}

.unity-scroll-view__content-viewport {
    background-color: rgba(35, 35, 35, 1);
}

.unity-scroller {
    background-color: rgba(30, 30, 30, 1);
}

.unity-scroller--vertical {
    width: 12px;
}

.unity-scroller--horizontal {
    height: 12px;
}

.unity-scroller__slider {
    background-color: rgba(50, 50, 50, 1);
    border-radius: 6px;
}

.unity-scroller__slider:hover {
    background-color: rgba(70, 70, 70, 1);
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

/* Common Dropdown Styles */
DropdownField {
    margin-top: 4px;
    margin-bottom: 4px;
}

DropdownField .unity-dropdown-field__input {
    background-color: rgba(50, 50, 50, 1);
    border-width: 1px;
    border-color: rgba(70, 70, 70, 1);
    border-radius: 3px;
    color: rgb(255, 255, 255);
    padding: 4px;
}

DropdownField .unity-dropdown-field__input:hover {
    border-color: rgba(100, 100, 100, 1);
}

DropdownField .unity-dropdown-field__input:focus {
    border-color: rgb(77, 150, 255);
}


/* Button theme */
.unity-button {
    -unity-font-style: normal;
    font-size: var(--font-size-xs);
    color: var(--color-bg);
    background-color: var(--background-color-dark-opacity);
    -unity-text-align: middle-center;
    unity-font-style: normal;
    border-color: var(--background-color-dark-opacity);
    border-radius: var(--border-radius-md);
}

.unity-button:hover {
    background-color: var(--color-primary-hover); /* darker on hover */
}

.unity-button:active {
    background-color: var(--color-primary-hover);
}

.unity-button:disabled {
    opacity: 0.5;
    pointer-events: none;
}

.unity-button--secondary {
    background-color: transparent;
    border-width: var(--border-width);
    border-color: var(--color-border); /* light border */
    color: var(--color-primary-light); /* primary text */
}

.unity-button--icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    -unity-content-align: middle-center;
}

/* Button variants */
.unity-button--primary {
    /* explicit primary — same as base but kept for clarity & tokens */
    background-color: var(--color-primary);
    color: var(--color-bg);
}

.unity-button--success {
    background-color: var(--color-success); /* green */
    color: var(--color-bg);
}

.unity-button--danger {
    background-color: var(--color-danger); /* red */
    color: var(--color-bg);
}

.unity-button--warning {
    background-color: var(--color-warning); /* orange */
    color: var(--color-bg);
}

.unity-button--ghost {
    background-color: transparent;
    color: var(--color-primary); /* using primary color for ghost text */
    border-width: 0;
}

.unity-button--circle {
    border-radius: var(--border-radius-full);
}

.unity-button--no-border {
    border-width: 0;
}

/* Hover/active states for variants (uses color darkening) */
.unity-button--success:hover { background-color: var(--color-success);  }
.unity-button--success:active { background-color: var(--color-success);  }

.unity-button--danger:hover { background-color: var(--color-danger);  }
.unity-button--danger:active { background-color: var(--color-danger);  }

.unity-button--warning:hover { background-color: var(--color-warning);  }
.unity-button--warning:active { background-color: var(--color-warning);  }

.unity-button--ghost:hover { background-color: rgba(79,70,229,0.06); }
.unity-button--ghost:active { background-color: rgba(79,70,229,0.12); }


/* Panel - a generic container used across UI for card/panel backgrounds */
.panel {
    background-color: var(--color-bg);
    border-width: var(--border-width);
    border-color: var(--color-border); /* subtle border */
    border-radius: var(--border-radius-md);
    padding: var(--space-md);
    color: var(--color-text); /* default panel text color */
    -unity-transition-property: background-color, opacity;
}

.panel--elevated {
    /* Slightly stronger visual elevation variant */
    border-color: rgba(2,6,23,0.06);
    /* unity-box-shadow is supported in newer Unity versions; if unavailable it will be ignored */
    unity-box-shadow: var(--shadow-lg);
}

.panel__header {
    font-size: var(--font-size-md);
    margin-bottom: var(--space-sm);
    color: var(--color-text);
}
