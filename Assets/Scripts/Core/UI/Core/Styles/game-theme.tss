@import url("unity-theme://default");

/* Dùng FontAsset (TextCore) — kéo thả trong Inspector */
.fa-solid {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Free-Solid-900 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.fa-regular {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Free-Regular-400 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.fa-brands {
    -unity-font-definition: url("/Assets/Resources/Fonts/fontawesome/Font Awesome 7 Brands-Regular-400 SDF.asset");
    font-size: 10px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}
