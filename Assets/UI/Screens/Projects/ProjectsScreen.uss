/* General Screen Styles */
.projects-screen {
    flex-grow: 1;
    background-color: var(--color-background);
    color: var(--color-text-primary);
}

/* Header */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background-color: rgba(34, 16, 22, 0.95); /* background-dark with opacity */
    border-bottom-width: 1px;
    border-bottom-color: var(--color-surface-border);
}

.header-left {
    flex-direction: row;
    align-items: center;
}

.avatar-container {
    width: 40px;
    height: 40px;
    margin-right: 12px;
}

.avatar-image {
    width: 100%;
    height: 100%;
    border-radius: var(--border-radius-full);
    border-width: 2px;
    border-color: var(--color-primary);
    -unity-background-scale-mode: scale-and-crop;
    /* Set background-image in C# */
}

.online-indicator {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 12px;
    height: 12px;
    background-color: var(--color-success);
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--color-background);
}

.header-title {
    font-size: var(--font-size-xl);
    -unity-font-style: bold;
}

.header-button {
    width: 40px;
    height: 40px;
    border-radius: var(--border-radius-full);
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
}

.header-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.header-button .material-symbols-outlined {
    font-size: var(--font-size-2xl);
    color: var(--color-text-secondary);
}

/* Search & Filters */
.search-filters-container {
    padding: 16px;
}

.search-bar {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface-1);
    border-radius: var(--border-radius-lg);
    height: 48px;
    padding: 0 12px;
    margin-bottom: 16px;
}

.search-icon {
    font-size: var(--font-size-2xl);
    color: var(--color-text-secondary);
    margin-right: 8px;
}

.search-input {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    height: 100%;
}

.filter-chips-container {
    flex-direction: row;
    height: 38px;
}

.filter-chip {
    height: 36px;
    padding: 0 16px;
    border-radius: var(--border-radius-md);
    background-color: var(--color-surface-1);
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    -unity-font-style: normal;
    border-width: 0;
    margin-right: 12px;
}

.filter-chip.active {
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
    -unity-font-style: bold;
}

/* Project Grid */
.project-grid-scroll {
    flex-grow: 1;
    padding: 0 16px;
}

.project-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.project-card {
    width: 48%; /* Creates a 2-column layout with a gap */
    background-color: var(--color-surface-1);
    border-radius: var(--border-radius-lg);
    padding: 8px;
    margin-bottom: 16px;
}

.project-card:hover {
    background-color: var(--color-surface-2);
}

.card-image-container {
    width: 100%;
    padding-top: 125%; /* Aspect ratio 4:5 */
    border-radius: var(--border-radius-md);
    overflow: hidden;
    position: relative;
    background-color: var(--color-background);
}

.card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: scale;
    transition-duration: 0.5s;
}

.project-card:hover .card-image {
    scale: 1.05 1.05;
}

.card-tag-container {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 2px 8px;
    border-radius: var(--border-radius-sm);
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: var(--color-surface-border);
}

.card-tag {
    font-size: var(--font-size-xs);
    -unity-font-style: bold;
    text-transform: uppercase;
    color: var(--color-text-primary);
}

.new-tag {
    background-color: var(--color-primary);
}

.card-menu-button {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: var(--border-radius-full);
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.project-card:hover .card-menu-button {
    opacity: 1;
}

.card-menu-button:hover {
    background-color: var(--color-primary);
}

.card-menu-button .material-symbols-outlined {
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
}

.card-info {
    padding: 12px 4px 4px;
}

.card-title {
    font-size: var(--font-size-base);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-overflow: ellipsis;
    white-space: nowrap;
}

.card-details {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.card-detail-icon {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin-right: 4px;
}

.card-detail-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

.card-detail-separator {
    margin: 0 4px;
    color: var(--color-text-secondary);
}

/* FAB */
.fab-container {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    align-items: center;
}

.fab {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 0 24px;
    border-radius: var(--border-radius-full);
    background-color: var(--color-primary);
    border-width: 0;
    transition-property: scale;
    transition-duration: 0.2s;
}

.fab:active {
    scale: 0.95 0.95;
}

.fab .unity-label {
    color: var(--color-primary-contrast);
    -unity-font-style: bold;
}

.fab .material-symbols-outlined {
    font-size: var(--font-size-2xl);
    margin-right: 8px;
}
