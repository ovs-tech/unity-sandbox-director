/* Screen Styles */
.timeline-screen {
    flex-grow: 1;
    background-color: var(--color-surface-3);
    color: var(--color-text-primary);
    overflow: hidden;
}

/* Header */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    background-color: var(--color-surface-3);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-surface-2);
}

.header-left, .header-right {
    flex-direction: row;
    align-items: center;
}

.header-button {
    width: 40px;
    height: 40px;
    justify-content: center;
    align-items: center;
    border-radius: var(--border-radius-full);
}
.header-button .material-symbols-outlined {
    font-size: var(--font-size-xl);
    color: var(--color-text-secondary);
}

.header-title-container {
    margin-left: 8px;
}

.header-title {
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
}
.header-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
}

.export-button {
    background-color: var(--color-primary-transparent);
    color: var(--color-primary);
    font-size: var(--font-size-base);
    -unity-font-style: bold;
    padding: 8px 16px;
    border-radius: var(--border-radius-full);
    margin-left: 8px;
}

/* Main Content */
.main-content {
    flex-grow: 1;
}

/* Preview Monitor */
.preview-monitor {
    height: 35%;
    background-color: black;
    position: relative;
}
.preview-background {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.9;
}
.preview-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(to bottom, rgba(0,0,0,0.4), transparent, rgba(0,0,0,0.6));
}

.monitor-top-controls {
    position: absolute;
    top: 16px;
    right: 16px;
    flex-direction: column;
}

.monitor-button {
    width: 40px;
    height: 40px;
    background-color: rgba(0,0,0,0.4);
    border-radius: var(--border-radius-md);
    justify-content: center;
    align-items: center;
    margin-bottom: 8px;
}
.monitor-button .material-symbols-outlined {
    color: var(--color-text-primary);
}

.playback-hud {
    position: absolute;
    bottom: 0;
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
}

.timecode {
    background-color: rgba(0,0,0,0.5);
    padding: 4px 8px;
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-sm);
}

.playback-controls {
    flex-direction: row;
    align-items: center;
}

.playback-button {
    width: 40px;
    height: 40px;
    justify-content: center;
    align-items: center;
}
.playback-button .material-symbols-outlined {
    color: var(--color-text-primary);
    font-size: var(--font-size-2xl);
}

.play-pause-button {
    width: 48px;
    height: 48px;
    border-radius: var(--border-radius-full);
    background-color: var(--color-primary);
    justify-content: center;
    align-items: center;
    margin: 0 16px;
}
.play-pause-button .material-symbols-outlined {
    color: var(--color-primary-contrast);
    font-size: 28px;
}

/* Timeline Toolbar */
.timeline-toolbar {
    height: 48px;
    background-color: var(--color-surface-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-surface-2);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
}

.toolbar-left {
    flex-direction: row;
    align-items: center;
}
.zoom-control {
    flex-direction: row;
    align-items: center;
    color: var(--color-text-muted);
}
.zoom-control .material-symbols-outlined {
    font-size: var(--font-size-xl);
    margin-right: 8px;
}

.toolbar-divider {
    width: 1px;
    height: 16px;
    background-color: var(--color-surface-border);
    margin: 0 16px;
}

.toolbar-button {
    padding: 6px;
    border-radius: var(--border-radius-sm);
}
.toolbar-button .material-symbols-outlined {
    font-size: var(--font-size-xl);
    color: var(--color-text-muted);
}
.toolbar-button.active .material-symbols-outlined {
    color: var(--color-primary);
}

.add-track-button {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-primary-transparent);
    color: var(--color-primary);
    border-radius: var(--border-radius-full);
    padding: 6px 12px;
}
.add-track-button .material-symbols-outlined {
    font-size: var(--font-size-md);
    margin-right: 4px;
}
.add-track-button .unity-label {
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

/* Timeline Area */
.timeline-area {
    flex-grow: 1;
    position: relative;
}

.playhead {
    position: absolute;
    left: 33.33%;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-primary);
}
.playhead-diamond {
    width: 12px;
    height: 12px;
    background-color: var(--color-primary);
    rotate: 45deg;
    position: absolute;
    top: -6px;
    left: -5px;
}

.time-ruler {
    height: 32px;
    background-color: var(--color-surface-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-surface-2);
    /* Drawing the ruler ticks would be done in C# */
}

.tracks-scroll-view {
    flex-grow: 1;
}

.track {
    flex-direction: row;
    height: 80px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-surface-border);
}

.track-header {
    width: 56px;
    background-color: var(--color-surface-1);
    border-right-width: 1px;
    border-right-color: var(--color-surface-border);
    align-items: center;
    justify-content: center;
}
.track-header .material-symbols-outlined {
    color: var(--color-text-secondary);
}
.track-label {
    font-size: 9px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: 4px;
}

.track-lanes {
    flex-grow: 1;
    position: relative;
    background-image: linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 10% 100%;
}

.clip {
    position: absolute;
    top: 8px;
    bottom: 8px;
    background-color: var(--color-primary-transparent);
    border-width: 1px;
    border-color: var(--color-primary);
    border-radius: var(--border-radius-md);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}
.clip.selected {
    border-width: 2px;
    border-color: var(--color-text-primary);
}
.clip-label {
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    white-space: nowrap;
    -unity-text-overflow: ellipsis;
    padding: 0 8px;
}
.clip-handle-right {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 12px;
    justify-content: center;
    align-items: center;
}

/* FAB */
.fab {
    position: absolute;
    bottom: 24px;
    right: 24px;
    width: 56px;
    height: 56px;
    border-radius: var(--border-radius-full);
    background-color: var(--color-primary);
    justify-content: center;
    align-items: center;
}
.fab .material-symbols-outlined {
    font-size: 28px;
    color: var(--color-primary-contrast);
}

/* Inspector Panel */
.inspector-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--color-surface-1);
    border-top-left-radius: var(--border-radius-lg);
    border-top-right-radius: var(--border-radius-lg);
    border-top-width: 1px;
    border-top-color: var(--color-surface-2);
}

.drag-handle-container {
    height: 24px;
    justify-content: center;
    align-items: center;
}
.drag-handle {
    width: 48px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: var(--border-radius-sm);
}

.inspector-content {
    padding: 8px 24px 24px;
}

.inspector-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}
.inspector-title {
    font-size: var(--font-size-md);
    -unity-font-style: bold;
}
.replace-button {
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    color: var(--color-primary);
    text-transform: uppercase;
}

.inspector-controls {
    flex-direction: row;
    justify-content: space-between;
}
.slider-control {
    flex-grow: 1;
    margin: 0 8px;
}
.slider-labels {
    flex-direction: row;
    justify-content: space-between;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: 8px;
}
